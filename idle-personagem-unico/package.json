{
  "name": "idle-personagem-unico",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @idle-pu/web",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "simular": "npm run simular -w @idle-pu/motor --",
    "ritmo": "npm run ritmo -w @idle-pu/motor --"
  },
  "engines": {
    "node": ">=22.12"
  }
}
