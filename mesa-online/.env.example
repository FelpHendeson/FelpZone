# Opcional em desenvolvimento: sem estas variáveis as salas ficam em memória.
# Em produção, a integração Upstash da Vercel cria um destes pares automaticamente.
UPSTASH_REDIS_REST_URL=https://adicione-sua-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=adicione_seu_token_aqui
# Alternativa usada por algumas versões da integração:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Opcional: avisos no celular (Web Push). Gere com `npx web-push generate-vapid-keys`.
# Sem elas, os avisos ficam desligados e o resto funciona.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:seu-email@exemplo.com
